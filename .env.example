# Copy this file to .env and add only the providers you want to use.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Models can be changed without editing code.
OPENAI_MODEL=gpt-5.6-sol
DEEPSEEK_MODEL=deepseek-v4-pro
GEMINI_MODEL=gemini-3.7-flash
ANTHROPIC_MODEL=claude-opus-5
JURY_MODEL=gpt-5.6-sol
AUDITOR_MODEL=deepseek-v4-pro

# openai, deepseek, or jury. Used to combine Ask All results.
SYNTHESIS_PROVIDER=jury
REQUEST_TIMEOUT_SECONDS=60
MAX_OUTPUT_TOKENS=1600

# Usage estimates in USD per 1M tokens. Update these when provider pricing changes.
OPENAI_INPUT_COST_PER_MILLION=4.00
OPENAI_OUTPUT_COST_PER_MILLION=20.00
DEEPSEEK_INPUT_COST_PER_MILLION=1.32
DEEPSEEK_OUTPUT_COST_PER_MILLION=3.96
GEMINI_INPUT_COST_PER_MILLION=0.75
GEMINI_OUTPUT_COST_PER_MILLION=3.75
ANTHROPIC_INPUT_COST_PER_MILLION=5.00
ANTHROPIC_OUTPUT_COST_PER_MILLION=25.00
COST_WARNING_USD=0.05
DAILY_BUDGET_USD=5.00

# Optional single-user access gate for network deployments. Leave blank for localhost-only use.
APP_ACCESS_TOKEN=
EMBEDDING_MODEL=text-embedding-3-small
ENABLE_EMBEDDINGS=false
VIDEO_VISION_MODEL=gpt-5.6-luna

# Optional Neo4j mirror for the local extracted graph.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
